GEMINI_API_KEY=your_gemini_api_key_here

# Optional: used to read release notes when the user doesn't supply a token (raises GitHub's limit from 60 to 5000 requests/hour).
# A fine-grained token with "Public repositories (read-only)" access and no other permissions is enough.
# GITHUB_TOKEN=github_pat_xxx

# Frontend URLs allowed to call the API (comma-separated). Defaults to http://localhost:3000
# ALLOWED_ORIGINS=https://your-app.vercel.app
# Optional regex for Vercel preview deployments
# ALLOWED_ORIGIN_REGEX=https://your-app-.*\.vercel\.app
